+/* ABLATION h-fixedpanel (phone only; research/design-engineering/morph-endpage.md R1). The morph panel keeps its
+   final size, clipped by the nav, so nothing inside it is resized (re-rasterized) per frame. Center and footer
+   follow the nav height H(m) = 52px + (panel-h - 52px) * m by translate; the veil by scaleY (set in JS, S()). */
+@media (width<=640px) {
+  .start-selling-top-nav .start-selling-morph-panel {
+    inset: 0 auto auto 50%;
+    width: var(--panel-w);
+    height: var(--panel-h);
+    translate: -50% 0;
+    transform-origin: 50% calc((52px + (var(--panel-h) - 52px) * var(--morph)) / 2);
+  }
+  .start-selling-top-nav .start-selling-morph-center {
+    translate: 0 calc((52px + (var(--panel-h) - 52px) * var(--morph) - var(--panel-h)) / 2);
+  }
+  .start-selling-top-nav .start-selling-morph-footer {
+    translate: 0 calc(52px + (var(--panel-h) - 52px) * var(--morph) - var(--panel-h));
+  }
+  .start-selling-top-nav .start-selling-morph-veil {
+    transform-origin: top;
+  }
+}
+
+/* ablation b (diagnostic only): no per-frame blur in the morph (panel filter, backdrop re-blur, platform filter) */
+.start-selling-morph-panel { filter: none !important; }
+.start-selling-morph-backdrop { -webkit-backdrop-filter: none !important; backdrop-filter: none !important; }
+.start-selling-platform { filter: none !important; }
