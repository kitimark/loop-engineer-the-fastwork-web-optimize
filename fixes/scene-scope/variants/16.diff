+/* [scene-scope R4a] --morph-fade is written inline on .start-selling-platform (JS 13279) and read only by that
+   element's own filter/opacity (this file, .start-selling-platform). Unregistered, it inherits, so every write
+   restyles the whole platform subtree; registered non-inheriting, only the element itself changes. */
+@property --morph-fade {
+  syntax: "<number>";
+  inherits: false;
+  initial-value: 1;
+}
+/* [scene-scope R4b] --morph is written inline on the nav header (JS 13614) and read by the header and some of its
+   descendants. Registered non-inheriting, a write restyles only the header plus the elements that take it with an
+   explicit `inherit` (the consumers and the wrappers between them and the header), not the whole nav subtree. */
+@property --morph {
+  syntax: "<number>";
+  inherits: false;
+  initial-value: 0;
+}
+.start-selling-top-nav-bar,
+.start-selling-top-nav-logo,
+.start-selling-top-nav-actions,
+.start-selling-top-nav-btn.is-earn,
+.start-selling-morph,
+.start-selling-morph-pill,
+.start-selling-morph-panel {
+  --morph: inherit;
 }
 .hero-track.svelte-1p2vpne {
   background: #fff;
@@ -11801,15 +11826,50 @@
 html[dir="rtl"] .start-selling :where(h1, h2, h3, h4, p, li, button, a, span) {
   unicode-bidi: plaintext;
 }
+/* [scene-scope V1] The paused-scene rules used to match every descendant (`:where(*)`). A rule whose subject is
+   universal makes an attribute change on the scene restyle the whole subtree (WebKit AttributeChangeInvalidation /
+   StyleInvalidator, Blink "invalidates subtree"): 172-399 elements at every scene flip. The subject is now the
+   list of elements that can carry a CSS animation (the subject compound of every `animation`/`animation-name`
+   rule in this file and DialogHeader.css; pseudo-elements were never matched by `:where(*)`), so a flip restyles
+   only those. [V1i] Only the INFINITE animations are paused; one-shot entrance animations (<= 1.7 s) finish even if
+   their scene pauses mid-way. animation-play-state is not inherited, so an unlisted element only differs by keeping a CSS
+   animation running while its scene is paused (CPU, not a visual change). */
 .start-selling [data-start-selling-scene="paused"],
-.start-selling [data-start-selling-scene="paused"] :where(*) {
+.start-selling [data-start-selling-scene="paused"] .frame-0,
+.start-selling [data-start-selling-scene="paused"] .frame-1,
+.start-selling [data-start-selling-scene="paused"] .frame-2,
+.start-selling [data-start-selling-scene="paused"] .typing-caret,
+.start-selling [data-start-selling-scene="paused"] .is-idle-frame-0,
+.start-selling [data-start-selling-scene="paused"] .is-idle-frame-1,
+.start-selling [data-start-selling-scene="paused"] .is-idle-frame-2,
+.start-selling [data-start-selling-scene="paused"] .scroll-float,
+.start-selling [data-start-selling-scene="paused"] .record,
+.start-selling [data-start-selling-scene="paused"] .start-selling-platform-row-title-doc,
+.start-selling [data-start-selling-scene="paused"] .start-selling-platform-row-title-earn,
+.start-selling [data-start-selling-scene="paused"] .start-selling-platform-row-title-secure,
+.start-selling [data-start-selling-scene="paused"] .start-selling-platform-row-title-organized,
+.start-selling [data-start-selling-scene="paused"] .start-selling-morph-col-track,
+.start-selling [data-start-selling-scene="paused"] .ring.svelte-16rtsv6 {
   animation-play-state: paused !important;
 }
 /* [scroll-engine /10b] layer budget: a layer only while the scene is active (gate at +-1 vh) AND the
    element is inside its +-0.5 vh window; both edges are off screen, and /09's no-re-skip keeps the gate
-   from flapping, so the flips happen away from the viewport. */
+   from flapping, so the flips happen away from the viewport.
+   [scene-scope V1] the scene arm lists the elements whose CSS asks for will-change (every non-auto
+   `will-change` rule in this file and DialogHeader.css) instead of `:where(*)`, for the same reason as above. */
 .start-selling [data-start-selling-scene="paused"],
-.start-selling [data-start-selling-scene="paused"] :where(*),
+.start-selling [data-start-selling-scene="paused"] .commission-card,
+.start-selling [data-start-selling-scene="paused"] .why-bring-panel,
+.start-selling [data-start-selling-scene="paused"] .face,
+.start-selling [data-start-selling-scene="paused"] .orbit-card,
+.start-selling [data-start-selling-scene="paused"] .hero-copy,
+.start-selling [data-start-selling-scene="paused"] .start-selling-future-card,
+.start-selling [data-start-selling-scene="paused"] .start-selling-profile-shell,
+.start-selling [data-start-selling-scene="paused"] .start-selling-platform-card,
+.start-selling [data-start-selling-scene="paused"] .start-selling-morph,
+.start-selling [data-start-selling-scene="paused"] .start-selling-morph-col-track,
+.start-selling [data-start-selling-scene="paused"] .start-selling-top-nav,
+.start-selling [data-start-selling-scene="paused"] .ring.svelte-16rtsv6,
 .start-selling [data-fw-wc="0"] {
