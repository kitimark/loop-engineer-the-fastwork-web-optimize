+/* [scene-scope R4a] --morph-fade is written inline on .start-selling-platform (JS 13279) and read only by that
+   element's own filter/opacity (this file, .start-selling-platform). Unregistered, it inherits, so every write
+   restyles the whole platform subtree; registered non-inheriting, only the element itself changes. */
+@property --morph-fade {
