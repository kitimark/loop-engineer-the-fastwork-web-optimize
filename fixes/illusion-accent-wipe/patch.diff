+/* illusion-accent-wipe (PoC): the word is revealed / hidden by a moving clip window instead of drawing the stroke
+   with stroke-dashoffset (a Layout difference on WebKit every frame, F-097, on the paths of all 3 boil frames).
+   .paint carries a static clip (inset -30%, so idle strokes that overflow the box are not cut) and slides by
+   -140% of its width; the visible frame-0 SVG slides +140% at the same time, so the word stands still while the
+   clip edge sweeps across it. Two transform animations, same duration and easing as the stroke draw: compositor
+   only, no per-frame style or layout. Draw-in reveals left to right; draw-out hides right to left (the original
+   un-draws from the path end back to its start). */
+.script-accent.svelte-1fn2go6 .paint.svelte-1fn2go6 {
+  clip-path: inset(-30%);
+}
+.is-drawing-in.svelte-1fn2go6 .accent-path.svelte-1fn2go6,
+.is-drawing-out.svelte-1fn2go6 .accent-path.svelte-1fn2go6 {
+  stroke-dasharray: none;
+  stroke-dashoffset: 0;
+  animation: none;
+}
+.is-drawing-in.svelte-1fn2go6 .accent-fill.svelte-1fn2go6,
+.is-drawing-out.svelte-1fn2go6 .accent-fill.svelte-1fn2go6 {
   opacity: 1;
+  animation: none;
 }
