+}
+.is-drawing-in.svelte-1fn2go6 .is-idle-frame-0.svelte-1fn2go6 {
+  animation: 0.9s cubic-bezier(0.4, 0, 0.2, 1) both fw-accent-wipe-in-counter;
+}
+.is-drawing-out.svelte-1fn2go6 .paint.svelte-1fn2go6 {
+  animation: 0.9s cubic-bezier(0.4, 0, 0.2, 1) forwards fw-accent-wipe-out;
+}
+.is-drawing-out.svelte-1fn2go6 .is-idle-frame-0.svelte-1fn2go6 {
