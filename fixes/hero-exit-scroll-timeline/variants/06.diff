+/* hero-exit-scroll-timeline: the hero exit (--exit-opacity / --exit-scatter, written per frame by JS
+   in the baseline) as CSS scroll-driven animations on the `--hero-exit` view timeline of .hero-track.
+   Range `contain 0% contain 100%` = the JS formula 1 - clamp(-top, 0, h - innerHeight) / (h - innerHeight).
+   Only once the entrance is over (desktop: .is-splash-done / .is-ring-splash-done; phones: always), the
+   same moment the JS stops writing --exit-opacity (hm in 2.DyWL8TcE.js), because keyframes must not
+   reference the entrance's animated --entered / --copy-in. On phones the scroll cue's own entrance
+   animates --copy-in, so its exit runs on its only child, .scroll-float (same pixels).
+   opacity/transform/translate animations are separate from the blur ones (compositable); the exit blur
+   starts just after 0 with fill none, so at rest filter is none instead of blur(0).
+   Where unsupported, the JS keeps writing --exit-opacity and the rules above apply unchanged. */
+@supports (animation-timeline: view()) and (animation-range: contain 0% contain 100%) {
+  @keyframes svelte-1p2vpne-hero-exit-card {
+    from {
+      opacity: 1;
+      translate: 0px 0px;
+    }
+    to {
+      opacity: 0.65;
+      translate: var(--scatter-x) var(--scatter-y);
+    }
+  }
+  @keyframes svelte-1p2vpne-hero-exit-copy {
+    from {
+      opacity: 1;
+      transform: translateY(0px);
+    }
+    to {
+      opacity: 0;
+      transform: translateY(-10px);
+    }
+  }
+  @keyframes svelte-1p2vpne-hero-exit-copy-m {
+    from {
+      opacity: 1;
+      transform: translate(-50%, 0px);
+    }
+    to {
+      opacity: 0;
+      transform: translate(-50%, -8px);
+    }
+  }
+  @keyframes svelte-1p2vpne-hero-exit-fade {
+    from {
+      opacity: 1;
+    }
+    to {
+      opacity: 0;
+    }
+  }
+  @keyframes svelte-1p2vpne-hero-exit-fade-up {
+    from {
+      opacity: 1;
+      translate: 0px 0px;
+    }
+    to {
+      opacity: 0;
+      translate: 0px -10px;
+    }
+  }
+  @keyframes svelte-1p2vpne-hero-exit-blur {
+    from {
+      filter: blur(0px);
+    }
+    to {
+      filter: blur(18px);
+    }
+  }
+  @media (prefers-reduced-motion: no-preference) {
+    .hero-track.svelte-1p2vpne {
+      view-timeline-name: --hero-exit;
+      view-timeline-axis: block;
+    }
+    @media (width>600px) {
+      .is-splash-done .orbit-card.svelte-1p2vpne,
+      .is-splash-done .orbit-card.float.svelte-1p2vpne {
+        animation: 1ms linear both svelte-1p2vpne-hero-exit-card;
+        animation-timeline: --hero-exit;
+        animation-range: contain 0% contain 100%;
+      }
+      .is-ring-splash-done .hero-copy.svelte-1p2vpne {
+        filter: none;
+        animation:
+          1ms linear both svelte-1p2vpne-hero-exit-copy;
+        animation-timeline: --hero-exit;
+        animation-range: contain 0% contain 100%;
+      }
+      .is-ring-splash-done .scroll-cue.svelte-1p2vpne {
+        filter: none;
+        animation:
+          1ms linear both svelte-1p2vpne-hero-exit-fade;
+        animation-timeline: --hero-exit;
+        animation-range: contain 0% contain 100%;
+      }
+    }
+    @media (width<=600px) {
+      .mobile-deck.svelte-1p2vpne .orbit-card:where(.svelte-1p2vpne) {
+        animation: 1ms linear both svelte-1p2vpne-hero-exit-card;
+        animation-timeline: --hero-exit;
+        animation-range: contain 0% contain 100%;
+      }
+      .hero-copy.svelte-1p2vpne,
+      .is-ring-splash-done .hero-copy.svelte-1p2vpne {
+        animation: 1ms linear both svelte-1p2vpne-hero-exit-copy-m;
+        animation-timeline: --hero-exit;
+        animation-range: contain 0% contain 100%;
+      }
+      .scroll-cue.svelte-1p2vpne {
+        filter: none;
+      }
+      .scroll-float.svelte-1p2vpne {
+        animation:
+          1ms linear both svelte-1p2vpne-hero-exit-fade-up,
+          2.2s ease-in-out infinite svelte-1p2vpne-scroll-float;
+        animation-timeline: --hero-exit, auto;
+        animation-range: contain 0% contain 100%, normal;
+      }
+    }
+  }
+}
