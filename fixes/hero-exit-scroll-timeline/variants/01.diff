+/* hero-exit-scroll-timeline: the hero exit (--exit-opacity / --exit-scatter, written per frame by JS
+   in the baseline) as CSS scroll-driven animations on the `--hero-exit` view timeline of .hero-track.
+   Range `contain 0% contain 100%` = the JS formula 1 - clamp(-top, 0, h - innerHeight) / (h - innerHeight).
+   opacity/transform/translate are in their own animations (compositable); the exit blur is a separate
+   animation that starts just after 0 (fill none), so at rest filter is none instead of blur(0).
+   Where unsupported, the JS keeps writing --exit-opacity and the rules above apply unchanged. */
+@supports (animation-timeline: view()) and (animation-range: contain 0% contain 100%) {
+  @keyframes svelte-1p2vpne-hero-exit-card {
+    from {
+      opacity: 1;
+      translate: calc((1 - var(--entered)) * var(--orbit-enter-x)) calc((1 - var(--entered)) * var(--orbit-enter-y));
+    }
+    to {
+      opacity: 0.65;
+      translate: calc((1 - var(--entered)) * var(--orbit-enter-x) + var(--scatter-x))
+        calc((1 - var(--entered)) * var(--orbit-enter-y) + var(--scatter-y));
+    }
+  }
+  @keyframes svelte-1p2vpne-hero-exit-copy {
+    from {
+      opacity: var(--copy-in);
+      transform: translateY(calc((1 - var(--copy-in)) * 12px));
+    }
+    to {
+      opacity: 0;
+      transform: translateY(calc((1 - var(--copy-in)) * 12px - 10px));
+    }
+  }
+  @keyframes svelte-1p2vpne-hero-exit-copy-m {
+    from {
+      opacity: 1;
+      transform: translate(-50%, 0px);
+    }
+    to {
+      opacity: 0;
+      transform: translate(-50%, -8px);
+    }
+  }
+  @keyframes svelte-1p2vpne-hero-exit-cue {
+    from {
+      opacity: var(--copy-in);
+      transform: translate(-50%, calc((1 - var(--copy-in)) * 12px));
+    }
+    to {
+      opacity: 0;
+      transform: translate(-50%, calc((1 - var(--copy-in)) * 12px - 10px));
+    }
+  }
+  @keyframes svelte-1p2vpne-hero-exit-fade {
+    from {
+      opacity: 1;
+    }
+    to {
+      opacity: 0;
+    }
+  }
+  @keyframes svelte-1p2vpne-hero-exit-blur {
+    from {
+      filter: blur(0px);
+    }
+    to {
+      filter: blur(18px);
+    }
+  }
+  @keyframes svelte-1p2vpne-hero-exit-blur-in {
+    from {
+      filter: blur(calc((1 - var(--copy-in)) * 16px));
+    }
+    to {
+      filter: blur(calc((1 - var(--copy-in)) * 16px + 18px));
+    }
+  }
+  @media (prefers-reduced-motion: no-preference) {
+    .hero-track.svelte-1p2vpne {
+      view-timeline-name: --hero-exit;
+      view-timeline-axis: block;
+    }
+    @media (width>600px) {
+      .orbit-card.svelte-1p2vpne {
+        animation:
+          1ms linear both svelte-1p2vpne-hero-exit-card,
+          svelte-1p2vpne-ring-appear 0.12s ease-out backwards,
+          svelte-1p2vpne-card-from-ring 1.7s cubic-bezier(0.2, 0.9, 0.2, 1) var(--orbit-enter-delay) both;
+        animation-timeline: --hero-exit, auto, auto;
+        animation-range: contain 0% contain 100%, normal, normal;
+      }
+      .is-splash-done .orbit-card.svelte-1p2vpne,
+      .is-splash-done .orbit-card.float.svelte-1p2vpne {
+        animation: 1ms linear both svelte-1p2vpne-hero-exit-card;
+        animation-timeline: --hero-exit;
+        animation-range: contain 0% contain 100%;
+      }
+      .hero-copy.svelte-1p2vpne {
+        animation:
+          1ms linear both svelte-1p2vpne-hero-exit-copy,
+          1ms linear svelte-1p2vpne-hero-exit-blur-in,
+          0.7s cubic-bezier(0.16, 1, 0.3, 1) 1.14s forwards svelte-1p2vpne-copy-from-ring;
+        animation-timeline: --hero-exit, --hero-exit, auto;
+        animation-range: contain 0% contain 100%, contain 0.05% contain 100%, normal;
+      }
+      .is-ring-splash-done .hero-copy.svelte-1p2vpne {
+        filter: none;
+        animation:
+          1ms linear both svelte-1p2vpne-hero-exit-copy,
+          1ms linear svelte-1p2vpne-hero-exit-blur;
+        animation-timeline: --hero-exit, --hero-exit;
+        animation-range: contain 0% contain 100%, contain 0.05% contain 100%;
+      }
+      .scroll-cue.svelte-1p2vpne {
+        animation:
+          1ms linear both svelte-1p2vpne-hero-exit-cue,
+          1ms linear svelte-1p2vpne-hero-exit-blur-in,
+          0.7s cubic-bezier(0.16, 1, 0.3, 1) 1.14s forwards svelte-1p2vpne-copy-from-ring;
+        animation-timeline: --hero-exit, --hero-exit, auto;
+        animation-range: contain 0% contain 100%, contain 0.05% contain 100%, normal;
+      }
+      .is-ring-splash-done .scroll-cue.svelte-1p2vpne {
+        filter: none;
+        animation:
+          1ms linear both svelte-1p2vpne-hero-exit-fade,
+          1ms linear svelte-1p2vpne-hero-exit-blur;
+        animation-timeline: --hero-exit, --hero-exit;
+        animation-range: contain 0% contain 100%, contain 0.05% contain 100%;
+      }
+    }
+    @media (width<=600px) {
+      .mobile-deck.svelte-1p2vpne .orbit-card:where(.svelte-1p2vpne) {
+        animation: 1ms linear both svelte-1p2vpne-hero-exit-card;
+        animation-timeline: --hero-exit;
+        animation-range: contain 0% contain 100%;
+      }
+      .hero-copy.svelte-1p2vpne,
+      .is-ring-splash-done .hero-copy.svelte-1p2vpne {
+        animation: 1ms linear both svelte-1p2vpne-hero-exit-copy-m;
+        animation-timeline: --hero-exit;
+        animation-range: contain 0% contain 100%;
+      }
+      .scroll-cue.svelte-1p2vpne {
+        filter: none;
+        animation:
+          1ms linear both svelte-1p2vpne-hero-exit-cue,
+          1ms linear svelte-1p2vpne-hero-exit-blur,
+          0.7s cubic-bezier(0.16, 1, 0.3, 1) 0.2s forwards svelte-1p2vpne-copy-in;
+        animation-timeline: --hero-exit, --hero-exit, auto;
+        animation-range: contain 0% contain 100%, contain 0.05% contain 100%, normal;
+      }
+    }
+  }
+}
