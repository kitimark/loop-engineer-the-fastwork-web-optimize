+      translate: var(--scatter-x) var(--scatter-y);
+    }
+  }
+  @keyframes svelte-1p2vpne-hero-exit-copy {
+    from {
+      opacity: 1;
+      transform: translateY(0px);
+    }
+    to {
+      opacity: 0;
+      transform: translateY(-10px);
+    }
+  }
+  @keyframes svelte-1p2vpne-hero-exit-copy-m {
+    from {
+      opacity: 1;
+      transform: translate(-50%, 0px);
+    }
+    to {
+      opacity: 0;
+      transform: translate(-50%, -8px);
+    }
+  }
+  @keyframes svelte-1p2vpne-hero-exit-fade {
+    from {
+      opacity: 1;
+    }
+    to {
+      opacity: 0;
+    }
+  }
+  @keyframes svelte-1p2vpne-hero-exit-fade-up {
+    from {
+      opacity: 1;
+      translate: 0px 0px;
