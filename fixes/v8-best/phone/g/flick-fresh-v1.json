{
  "name": "flick-fresh-v1",
  "version": 1,
  "screen": [430, 932],
  "about": "T-113 (1): fresh load, then fast flicks from the top through the hero right away (no idle). Attribution only.",
  "params": { "x": 215, "flingPx": 560, "flingMs": 140, "afterMs": 300, "gapMs": 350 },
  "steps": [
    { "type": "reload", "scrollAfterMs": "$afterMs" },
    { "type": "mark", "name": "fresh-flick" },
    { "type": "stroke", "dir": "up", "px": "$flingPx", "ms": "$flingMs", "profile": "fling" },
    { "type": "pause", "ms": "$gapMs" },
    { "type": "stroke", "dir": "up", "px": "$flingPx", "ms": "$flingMs", "profile": "fling" },
    { "type": "pause", "ms": "$gapMs" },
    { "type": "stroke", "dir": "up", "px": "$flingPx", "ms": "$flingMs", "profile": "fling" },
    { "type": "until", "cond": "settled", "timeoutMs": 5000, "optional": true },
    { "type": "mark", "name": "rest" },
    { "type": "pause", "ms": 1500 },
    { "type": "mark", "name": "end" }
  ]
}
