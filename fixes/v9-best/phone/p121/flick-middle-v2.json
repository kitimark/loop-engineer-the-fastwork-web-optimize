{
  "name": "flick-middle-v2",
  "version": 2,
  "screen": [430, 932],
  "about": "P-121 part M (path-matched, written after H3a2): flick-middle-v1's structure (slow approach to y >= 1900, rest, three up/down fling pairs) with weaker flings, calibrated on baseline B to travel about 2000-2500 px, so every fling swings over the middle (band 2200-3800) and reaches neither end (v8's 5220, v9's end screen). flingPx / flingMs are placeholders until the calibration picks and pins them.",
  "params": { "x": 215, "flingPx": 360, "flingMs": 140, "stillPx": 520, "stillMs": 600 },
  "steps": [
    { "type": "reload", "scrollAfterMs": 0 },
    { "type": "repeat", "times": 8, "until": "y>=1900", "steps": [
      { "type": "stroke", "dir": "up", "px": "$stillPx", "ms": "$stillMs", "profile": "still" },
      { "type": "pause", "ms": 150 }
    ] },
    { "type": "until", "cond": "y>=1900", "timeoutMs": 6000 },
    { "type": "until", "cond": "settled", "timeoutMs": 4000, "optional": true },
    { "type": "pause", "ms": 1500 },
    { "type": "mark", "name": "mid1" },
    { "type": "stroke", "dir": "up", "px": "$flingPx", "ms": "$flingMs", "profile": "fling" },
    { "type": "until", "cond": "settled", "timeoutMs": 5000, "optional": true },
    { "type": "pause", "ms": 600 },
    { "type": "until", "cond": "y>=1900", "timeoutMs": 2000 },
    { "type": "stroke", "dir": "down", "px": "$flingPx", "ms": "$flingMs", "profile": "fling" },
    { "type": "until", "cond": "settled", "timeoutMs": 5000, "optional": true },
    { "type": "pause", "ms": 600 },
    { "type": "until", "cond": "y>=600", "timeoutMs": 2000 },
    { "type": "stroke", "dir": "up", "px": "$flingPx", "ms": "$flingMs", "profile": "fling" },
    { "type": "until", "cond": "settled", "timeoutMs": 5000, "optional": true },
    { "type": "pause", "ms": 600 },
    { "type": "until", "cond": "y>=1900", "timeoutMs": 2000 },
    { "type": "stroke", "dir": "down", "px": "$flingPx", "ms": "$flingMs", "profile": "fling" },
    { "type": "until", "cond": "settled", "timeoutMs": 5000, "optional": true },
    { "type": "pause", "ms": 600 },
    { "type": "until", "cond": "y>=600", "timeoutMs": 2000 },
    { "type": "stroke", "dir": "up", "px": "$flingPx", "ms": "$flingMs", "profile": "fling" },
    { "type": "until", "cond": "settled", "timeoutMs": 5000, "optional": true },
    { "type": "pause", "ms": 600 },
    { "type": "until", "cond": "y>=1900", "timeoutMs": 2000 },
    { "type": "stroke", "dir": "down", "px": "$flingPx", "ms": "$flingMs", "profile": "fling" },
    { "type": "until", "cond": "settled", "timeoutMs": 5000, "optional": true },
    { "type": "mark", "name": "end" }
  ]
}
