--- a/_app/immutable/assets/2.gBuqKVzi.css
+++ b/_app/immutable/assets/2.gBuqKVzi.css
@@ -2910,7 +2910,32 @@
   animation:
     0.22s cubic-bezier(0.33, 1, 0.68, 1) forwards avatars-shift,
     0.22s cubic-bezier(0.16, 1, 0.3, 1) forwards avatars-pop;
+}
+/* st5: 5 persistent slots. Every slot keeps its own layer for the page's life (no layer gain/loss when the
+   slide starts or ends); the 5th waits at the pop's start state; .is-sliding (toggled by the rotator) runs the
+   same keyframes, easings and duration as the keyed version */
+.start-selling-avatars.is-carousel img {
+  will-change: transform, translate, opacity;
+  /* st6 (de-pm-hero's no-flip probe): every slot always has a transform and is never fully opaque, so no
+     style change ever flips hasTransform() or opacity isOpaque() (WebKit miscDataChangeRequiresLayout) */
+  transform: scale(1);
+  opacity: 0.999;
 }
+.start-selling-avatars.is-carousel img.st5-next {
+  opacity: 0;
+  transform: scale(0.35);
+}
+.start-selling-avatars.is-carousel.is-sliding img.st5-lead {
+  animation: 0.22s cubic-bezier(0.33, 1, 0.68, 1) forwards avatars-exit;
+}
+.start-selling-avatars.is-carousel.is-sliding img.st5-lead ~ img {
+  animation: 0.22s cubic-bezier(0.33, 1, 0.68, 1) forwards avatars-shift;
+}
+.start-selling-avatars.is-carousel.is-sliding img.st5-lead ~ img.st5-next {
+  animation:
+    0.22s cubic-bezier(0.33, 1, 0.68, 1) forwards avatars-shift,
+    0.22s cubic-bezier(0.16, 1, 0.3, 1) forwards avatars-pop;
+}
 @keyframes avatars-shift {
   0% {
     translate: 0;
@@ -2921,7 +2946,7 @@
 }
