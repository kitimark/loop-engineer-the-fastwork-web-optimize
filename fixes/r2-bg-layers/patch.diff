@@ -925,7 +925,25 @@
     --commission-shrink-scale: 1;
     --commission-shrink-radius: 0px;
     overflow: visible;
+  }
+  /* R2: on phones .shrinking is only a background switch (scale 1, radius 0, runway display:none). The
+     colour lives on an empty ::before layer (.commission is a stacking context: z-index 3), so the switch
+     is a layer property, not a repaint of the section. */
+  .commission.shrinking {
+    background: 0 0;
+  }
+  .commission::before {
+    content: "";
+    z-index: -1;
+    pointer-events: none;
+    will-change: transform;
+    background: 0 0;
+    position: absolute;
+    inset: 0;
   }
+  .commission.shrinking::before {
+    background: #131922;
+  }
   .commission-sticky {
     min-height: 0;
     position: relative;
@@ -2309,14 +2327,25 @@
