+    transform 0.9s cubic-bezier(0.16, 1, 0.3, 1);
 }
+.start-selling-future[data-fw-reveal].is-visible > .start-selling-future-card:not([data-fw-revealed]) {
+  filter: blur(0px);
+}
+.start-selling-future[data-fw-reveal].is-visible > .start-selling-future-card[data-fw-revealed] {
+  transition:
+    opacity 0.7s cubic-bezier(0.16, 1, 0.3, 1),
