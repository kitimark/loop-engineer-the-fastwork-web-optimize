+/* nav-earn rev 2 (T-154): at the top of the page Join waitlist follows the scroll instead of its own clock.
+   --earn-in (0 -> 1 over hero progress 0.58 -> 0.72, written inline by the nav's scroll callback on the actions row
+   and the button) drives, in the hero-pill state only, what --nav-expand and the 0.68 s / 0.32 s transitions and the
+   0.52 s + 0.98 s unmask animation drove after the class flip: the width, padding, gap, fade and the left-to-right
+   mask sweep, with no transition of their own. At progress 0.72 the pill state ends with everything at its full
+   value, so the flip changes nothing and the unmask (which would hide the shown button again) is replaced by its
+   end state (mask kept, at position 0 0: the same pixels as the finished animation, also under the end-of-page
+   blur). The sheen keeps its own timing. Reduced motion: never in the pill state after load (JS), unchanged. */
+@property --earn-in {
+  syntax: "<number>";
+  inherits: false;
+  initial-value: 0;
+}
+.start-selling-top-nav.is-hero-pill.svelte-1dcozpm .start-selling-top-nav-actions:where(.svelte-1dcozpm) {
+  gap: calc(var(--earn-in) * 8px);
+  transition: none;
+}
+.start-selling-top-nav.is-hero-pill.svelte-1dcozpm .start-selling-top-nav-btn.is-earn:where(.svelte-1dcozpm) {
+  --earn-layout: calc(var(--earn-in) * (1 - var(--earn-out)));
+  opacity: calc((1 - var(--earn-out)) * var(--earn-in));
+  transition: none;
+}
+@media (width<=640px) {
+  .start-selling-top-nav.is-hero-pill.svelte-1dcozpm .start-selling-top-nav-actions:where(.svelte-1dcozpm) {
+    gap: calc(var(--earn-in) * 4px);
+  }
+}
+@media (prefers-reduced-motion: no-preference) {
+  .start-selling-top-nav.is-hero-pill.svelte-1dcozpm .start-selling-top-nav-btn.is-earn:where(.svelte-1dcozpm) {
+    -webkit-mask-image: var(--nav-earn-mask);
+    mask-image: var(--nav-earn-mask);
+    -webkit-mask-size: 240% 100%;
+    mask-size: 240% 100%;
+    -webkit-mask-repeat: no-repeat;
+    mask-repeat: no-repeat;
+    -webkit-mask-position: calc((1 - var(--earn-in)) * 100%) 0;
+    mask-position: calc((1 - var(--earn-in)) * 100%) 0;
+  }
+  .start-selling-top-nav.svelte-1dcozpm:not(.is-hero-pill)
+    .start-selling-top-nav-btn.is-earn:where(.svelte-1dcozpm) {
+    animation: none;
+    -webkit-mask-position: 0 0;
+    mask-position: 0 0;
+  }
+}
 @keyframes svelte-1dcozpm-start-selling-nav-earn-unmask {
