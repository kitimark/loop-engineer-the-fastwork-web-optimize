+/* g0-box v3 (gpu-original M3-B, option 3; phones <= 640 px). The nav keeps v0's box per frame (top, width, height,
+   backdrop blur) and its menu card is untouched, but the nav paints nothing itself: its colour is two composited solid
+   fills (light #ffffff1a, dark #131922 at opacity --morph: source-over of the two is v0's premultiplied color-mix
+   exactly), its rounded corner is clip-path inset(0 round r) (a shape mask on the composited layer: a radius change
+   repaints nothing). */
+.fw-bx-fill {
+  display: none;
+}
+@media (width<=640px) {
+  .start-selling-top-nav.svelte-1dcozpm {
+    background: none;
+    border-radius: 0;
+    clip-path: inset(0 round calc(32px - 12px * var(--morph)));
+  }
+  .start-selling-top-nav.is-locale-open.svelte-1dcozpm {
+    clip-path: none;
+    border-radius: calc(32px - 12px * var(--morph));
+  }
+  .start-selling-top-nav > .fw-bx-fill {
+    display: block;
+    position: absolute;
+    inset: 0;
+    z-index: 0;
+    pointer-events: none;
+    will-change: transform;
+  }
+  .start-selling-top-nav.is-locale-open > .fw-bx-fill {
+    border-radius: inherit;
+  }
+  .start-selling-top-nav > .fw-bx-light {
+    background: #ffffff1a;
+  }
+  .start-selling-top-nav > .fw-bx-dark {
+    --morph: inherit;
+    background: #131922;
+    opacity: var(--morph);
+    will-change: opacity;
+  }
+}
