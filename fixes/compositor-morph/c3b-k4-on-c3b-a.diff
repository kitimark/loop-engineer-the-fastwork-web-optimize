     filter: blur(10px);
   }
 }
+/* c3b-K2 (arch-compositor-morph): the CM layers are built near the end while the morph is still closed ("pre":
+   .is-morphing with .fw-cm-pre, JS __cmPreSet). Under pre the nav must look and behave like today's closed pill:
+   the glass is on the bar (its own backdrop, cut to its own box, as today's nav) instead of u3's panel-sized one; today's closed transitions (the scroll-hidden slide by the pill's height, the actions' gap)
+   and the Join button's taps. */
+@media (width<=640px) {
+  html.fw-cm .start-selling-top-nav.svelte-1dcozpm.is-morphing.fw-cm-pre {
+    transition:
+      opacity 0.28s cubic-bezier(0.16, 1, 0.3, 1),
+      transform 0.32s cubic-bezier(0.16, 1, 0.3, 1),
+      visibility 0s linear 0.32s;
+  }
+  html.fw-cm .start-selling-top-nav.svelte-1dcozpm.is-morphing.fw-cm-pre:not(.is-scroll-hidden) {
+    transition-delay: 0s;
+  }
+  html.fw-cm .start-selling-top-nav.svelte-1dcozpm.is-morphing.fw-cm-pre.is-scroll-hidden {
+    transform: translate(-50%) translateY(calc(-1 * var(--pill-h) - 24px));
+  }
+  html.fw-cm .start-selling-top-nav.svelte-1dcozpm.is-morphing.fw-cm-pre [data-fw-cm="u3"] {
+    background: none;
+    -webkit-backdrop-filter: none !important;
+    backdrop-filter: none !important;
+  }
+  /* the glass on the bar (pill height, the corner clippers cut its width to the pill's): its backdrop is cut to its own
+     box, as today's nav's is, and it stays the backdrop root of the language switch's own blur */
+  html.fw-cm .start-selling-top-nav.svelte-1dcozpm.is-morphing.fw-cm-pre .start-selling-top-nav-bar:where(.svelte-1dcozpm) {
+    background: #ffffff1a;
+    -webkit-backdrop-filter: blur(20px);
+    backdrop-filter: blur(20px);
+    border-radius: 32px;
+  }
+  html.fw-cm .start-selling-top-nav.svelte-1dcozpm.is-morphing.fw-cm-pre .start-selling-top-nav-actions:where(.svelte-1dcozpm) {
+    transition: gap 0.68s cubic-bezier(0.33, 0, 0.2, 1);
+  }
+  html.fw-cm .start-selling-top-nav.svelte-1dcozpm.is-morphing.fw-cm-pre:not(.is-hero-pill) .start-selling-top-nav-btn.is-earn:where(.svelte-1dcozpm) {
+    pointer-events: auto;
+  }
+}
