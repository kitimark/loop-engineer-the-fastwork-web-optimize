+/* timed fade (PR-032 rev 3, user 03:13Z): at the end of the page under CM (html.fw-cm, phone widths) the Join button
+   leaves and comes back on a timer started by its state flip (.is-earn-hidden: on at m 0.2, off at m 0), never with the
+   finger: opacity and blur on the button's own transitions (0.32 s cubic-bezier(0.33, 0, 0.2, 1) after 0.12 s, the
+   button's appear transition at the top of the page), the pill keeps its shape and place, and the language switch
+   slides by the button's width and the 4 px gap on nav-earn's 0.68 s timer (JS __ewGo). Opacity, filter and translate
+   only (compositor). The button stays on its own layer (will-change), so no layer is made when a fade starts. */
+@media (width<=640px) {
+  html.fw-cm .start-selling-top-nav.svelte-1dcozpm .start-selling-top-nav-btn.is-earn:where(.svelte-1dcozpm) {
+    will-change: opacity, filter;
+  }
+  html.fw-cm .start-selling-top-nav.svelte-1dcozpm.is-earn-hidden:not(.is-hero-pill) .start-selling-top-nav-btn.is-earn:where(.svelte-1dcozpm) {
+    translate: none;
+  }
+  html.fw-cm .start-selling-top-nav.svelte-1dcozpm.is-earn-hidden:not(.is-hero-pill) .start-selling-top-nav-earn-box:where(.svelte-1dcozpm) {
+    clip-path: none;
+  }
+  html.fw-cm .start-selling-top-nav.svelte-1dcozpm.is-earn-hidden:not(.is-hero-pill) .start-selling-top-nav-actions:where(.svelte-1dcozpm) > .start-selling-language-switch-wrap {
+    translate: calc(var(--earn-w, 0px) + 4px) 0;
+  }
+  html.fw-cm .start-selling-top-nav.svelte-1dcozpm.is-morphing .start-selling-top-nav-actions:where(.svelte-1dcozpm) > .start-selling-language-switch-wrap {
+    transform: none;
+  }
+}
+@media (width<=640px) and (prefers-reduced-motion: no-preference) {
+  html.fw-cm .start-selling-top-nav.svelte-1dcozpm:not(.is-hero-pill) .start-selling-top-nav-btn.is-earn:where(.svelte-1dcozpm) {
+    filter: blur(0px);
+    transition:
+      opacity 0.32s cubic-bezier(0.33, 0, 0.2, 1) 0.12s,
+      filter 0.32s cubic-bezier(0.33, 0, 0.2, 1) 0.12s;
+  }
+  html.fw-cm .start-selling-top-nav.svelte-1dcozpm.is-earn-hidden:not(.is-hero-pill) .start-selling-top-nav-btn.is-earn:where(.svelte-1dcozpm) {
+    filter: blur(10px);
+  }
+}
