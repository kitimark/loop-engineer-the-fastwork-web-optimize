+
+/* [reveal-paint] g0.0m, touch screens only (the query of g0.0l's photo preload): the hidden #people card is rendered at
+   opacity 0 instead of visibility: hidden, and opacity joins its will-change, so WebKit paints the card's and the deck's
+   layers while the card is invisible (at load and at rest) instead of in the reveal frame. visibility: hidden keeps a
+   layer from drawing content (WebKit RenderLayer::computeHasVisibleContent), and an opacity-0 layer draws content only
+   when will-change names opacity (RenderLayerBacking::containsPaintedContent -> Styleable::mayHaveNonZeroOpacity). The
+   reveal then changes only opacity, filter and transform on the composited card (RenderElement::adjustStyleDifference:
+   RecompositeLayer). The card stays at opacity 0 while hidden, so nothing visible changes. While hidden, the descendants
+   that inherited visibility: hidden take no tap either (the people faces set pointer-events: auto; visibility: hidden
+   used to keep them out of hit testing); a pointer-events change is RecompositeLayer, not a repaint (StyleDifference).
+   The profile tabs are left alone: their own rules set their visibility (hidden, or visible on phones and with
+   .is-rail-in), so they behave as in g0.0l, where they are not hidden with the card either. */
+@media (hover: none) and (pointer: coarse) {
+  .start-selling-future:not(.is-visible) > .start-selling-future-card {
+    visibility: visible;
+  }
+  .start-selling-future:not(.is-visible)
+    > .start-selling-future-card
+    *:not(.start-selling-profile-tabs, .start-selling-profile-tabs *) {
+    pointer-events: none !important;
+  }
+  .start-selling-future > .start-selling-future-card {
+    will-change: transform, border-radius, opacity;
+  }
+}
