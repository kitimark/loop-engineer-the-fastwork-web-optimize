{
  "name": "fastwork-com-web-optimize",
  "private": true,
  "description": "Local, personal-use mirror of the fastwork.com homepage for scroll-performance experiments",
  "type": "module",
  "engines": { "node": ">=22" },
  "scripts": {
    "mirror": "node tools/mirror.mjs",
    "mirror:full": "node tools/mirror.mjs --crawl --vendors",
    "serve": "node tools/serve.mjs",
    "serve:vendors": "node tools/serve.mjs --vendors=local",
    "serve:https": "node tools/serve.mjs --https",
    "prettify": "node tools/prettify.mjs",
    "verify": "node tools/verify.mjs live=https://fastwork.com/ local=http://localhost:5173/",
    "fix": "node tools/fix.mjs",
    "lock": "node tools/lock.mjs",
    "iphone": "node tools/iphone.mjs",
    "test": "node --test --test-concurrency=3 --test-timeout=120000 \"tests/unit/*.test.mjs\" \"tests/e2e/*.test.mjs\" \"tests/hooks/*.test.mjs\"",
    "test:unit": "node tools/scope.mjs && node --test --test-concurrency=2 --test-timeout=120000 \"tests/unit/*.test.mjs\"",
    "test:scope": "node tools/scope.mjs",
    "test:hooks": "node --test \"tests/hooks/*.test.mjs\"",
    "test:bench": "node tools/bench.mjs reconfirm",
    "test:chrome": "node tools/lock.mjs run chrome-measure --short --max-seconds 300 --owner test-chrome -- node --test --test-concurrency=1 --test-timeout=600000 \"tests/chrome/*.test.mjs\"",
    "test:all": "npm test && npm run test:chrome",
    "setup": "git config core.hooksPath .githooks"
  }
}
