{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "worktree": {
    "baseRef": "head"
  },
  "permissions": {
    "allow": [
      "Bash(node tools/fix.mjs *)",
      "Bash(node tools/serve.mjs *)",
      "Bash(node tools/verify.mjs *)",
      "Bash(node tools/lock.mjs *)",
      "Bash(node tools/iphone.mjs *)",
      "Bash(node --check *)",
      "Bash(curl -sk https://localhost:*)",
      "Bash(curl -s http://localhost:*)",
      "Bash(git worktree list *)",
      "Bash(git worktree add .claude/worktrees/*)",
      "mcp__serena__find_symbol",
      "mcp__serena__find_referencing_symbols",
      "mcp__serena__get_symbols_overview",
      "mcp__serena__find_declaration",
      "mcp__serena__find_implementations",
      "mcp__serena__list_memories",
      "mcp__serena__read_memory",
      "mcp__serena__initial_instructions"
    ],
    "ask": [
      "Bash(git config merge.ff *)",
      "Bash(git config pull.rebase *)",
      "Bash(git remote add *)",
      "Edit(/.claude/hooks/**)",
      "Edit(/.claude/worktrees/*/.claude/hooks/**)",
      "Bash(node tools/mirror.mjs *)",
      "Bash(node tools/prettify.mjs *)"
    ],
    "deny": [
      "mcp__chrome-devtools__performance_start_trace",
      "mcp__chrome-devtools__performance_stop_trace",
      "mcp__chrome-devtools__performance_analyze_insight",
      "Bash(git push *)",
      "Bash(git -C * push *)",
      "Bash(git merge --no-ff *)",
      "Bash(git merge --squash *)",
      "Bash(git merge --continue *)",
      "Bash(git merge --no-verify *)",
      "Bash(git pull --no-rebase *)",
      "Bash(git commit --no-verify *)",
      "Bash(git commit -n *)",
      "Bash(git -c core.hooksPath*)",
      "Bash(gh repo create *)",
      "Bash(gh pr create *)",
      "Bash(gh pr merge *)",
      "Bash(gh gist create *)",
      "Bash(node tools/verify.mjs *--no-lock*)",
      "Bash(git add -f *)",
      "Bash(git add --force *)",
      "Edit(/site/**)",
      "Edit(/site-pretty/**)",
      "mcp__serena__replace_symbol_body",
      "mcp__serena__insert_after_symbol",
      "mcp__serena__insert_before_symbol",
      "mcp__serena__replace_content",
      "mcp__serena__replace_in_files",
      "mcp__serena__rename_symbol",
      "mcp__serena__safe_delete_symbol",
      "mcp__serena__create_text_file",
      "mcp__serena__execute_shell_command",
      "mcp__serena__write_memory",
      "mcp__serena__edit_memory",
      "mcp__serena__delete_memory",
      "mcp__serena__rename_memory"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/git-guard.mjs"],
            "timeout": 10
          }
        ]
      }
    ]
  }
}
