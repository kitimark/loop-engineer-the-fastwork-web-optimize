{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "worktree": {
    "baseRef": "head"
  },
  "permissions": {
    "allow": [
      "Bash(node tools/fix.mjs *)",
      "Bash(node tools/serve.mjs *)",
      "Bash(node tools/verify.mjs *)",
      "Bash(node tools/lock.mjs *)",
      "Bash(node tools/iphone.mjs *)",
      "Bash(node --check *)",
      "Bash(curl -sk https://localhost:*)",
      "Bash(curl -s http://localhost:*)",
      "Bash(git worktree list *)",
      "Bash(git worktree add .claude/worktrees/*)",
      "Bash(git worktree remove .claude/worktrees/*)",
      "Bash(git rebase main)",
      "Bash(git -C .claude/worktrees/* rebase main)",
      "Bash(git merge --ff-only wt/*)",
      "Bash(git merge --ff-only worktree-*)",
      "Bash(git branch -d wt/*)",
      "Bash(git branch -d worktree-*)",
      "Bash(node tools/incident.mjs *)",
      "Bash(npm test)",
      "Bash(npm run test:*)",
      "mcp__serena__find_symbol",
      "mcp__serena__find_referencing_symbols",
      "mcp__serena__get_symbols_overview",
      "mcp__serena__find_declaration",
      "mcp__serena__find_implementations",
      "mcp__serena__list_memories",
      "mcp__serena__read_memory",
      "mcp__serena__initial_instructions"
    ],
    "ask": [
      "Bash(git config merge.ff *)",
      "Bash(git config pull.rebase *)",
      "Bash(git remote add *)",
      "Edit(/.claude/hooks/**)",
      "Edit(/.claude/worktrees/*/.claude/hooks/**)",
      "Bash(node tools/mirror.mjs *)",
      "Bash(node tools/prettify.mjs *)",
      "Bash(git commit *--no-verify*)",
      "Bash(git commit * -n *)",
      "Bash(git commit * -n)",
      "Bash(git config *core.hooksPath*)",
      "Bash(node tools/ioscap.mjs record *--first-run*)",
      "Edit(/tools/ioscap/**)",
      "Edit(/.claude/worktrees/*/tools/ioscap/**)",
      "Edit(/tests/unit/ioscap-source.test.mjs)",
      "Edit(/.claude/worktrees/*/tests/unit/ioscap-source.test.mjs)",
      "Edit(/tools/ioscap.mjs)",
      "Edit(/.claude/worktrees/*/tools/ioscap.mjs)",
      "Edit(/tools/lib/ioscap.mjs)",
      "Edit(/.claude/worktrees/*/tools/lib/ioscap.mjs)"
    ],
    "deny": [
      "mcp__chrome-devtools__performance_start_trace",
      "mcp__chrome-devtools__performance_stop_trace",
      "mcp__chrome-devtools__performance_analyze_insight",
      "Bash(git push *)",
      "Bash(git -C * push *)",
      "Bash(git merge --no-ff *)",
      "Bash(git merge --squash *)",
      "Bash(git merge --continue *)",
      "Bash(git merge --no-verify *)",
      "Bash(git pull --no-rebase *)",
      "Bash(git commit --no-verify *)",
      "Bash(git commit -n *)",
      "Bash(git -c core.hooksPath*)",
      "Bash(gh repo create *)",
      "Bash(gh pr create *)",
      "Bash(gh pr merge *)",
      "Bash(gh gist create *)",
      "Bash(node tools/verify.mjs *--no-lock*)",
      "Bash(node tools/lock.mjs run * -- git *)",
      "Bash(node tools/lock.mjs run * -- gh *)",
      "Bash(git add -f *)",
      "Bash(git add --force *)",
      "Bash(osascript *QuickTime*)",
      "Bash(open *QuickTime*)",
      "Bash(open *ioscap.app*)",
      "Bash(system_profiler *SPCameraDataType*)",
      "Bash(ffmpeg *avfoundation*)",
      "Bash(imagesnap*)",
      "Bash(screencapture *-v*)",
      "Bash(screencapture *-V*)",
      "Bash(open *Photo Booth*)",
      "Bash(open *PhotoBooth*)",
      "Bash(open *FaceTime*)",
      "Bash(open *facetime*)",
      "Bash(osascript *Photo Booth*)",
      "Bash(osascript *PhotoBooth*)",
      "Bash(osascript *FaceTime*)",
      "Bash(open *ioscap*)",
      "Bash(osascript *ioscap*)",
      "Bash(swift *tools/ioscap/*)",
      "Bash(open *iphone-screen*)",
      "Bash(qlmanage *)",
      "Bash(ffplay *)",
      "Read(/out/iphone-screen/**/*.mov)",
      "Read(/out/iphone-screen/**/*.mp4)",
      "Read(/out/iphone-screen/**/*.m4v)",
      "Read(/out/iphone-screen/**/*.png)",
      "Read(/out/iphone-screen/**/*.jpg)",
      "Read(/out/iphone-screen/**/*.jpeg)",
      "Read(/out/iphone-screen/**/*.heic)",
      "Read(/.claude/worktrees/*/out/iphone-screen/**/*.mov)",
      "Read(/.claude/worktrees/*/out/iphone-screen/**/*.mp4)",
      "Read(/.claude/worktrees/*/out/iphone-screen/**/*.m4v)",
      "Read(/.claude/worktrees/*/out/iphone-screen/**/*.png)",
      "Read(/.claude/worktrees/*/out/iphone-screen/**/*.jpg)",
      "Read(/.claude/worktrees/*/out/iphone-screen/**/*.jpeg)",
      "Read(/.claude/worktrees/*/out/iphone-screen/**/*.heic)",
      "Edit(/site/**)",
      "Edit(/site-pretty/**)",
      "Edit(/.claude/worktrees/*/site/**)",
      "Edit(/.claude/worktrees/*/site-pretty/**)",
      "mcp__serena__replace_symbol_body",
      "mcp__serena__insert_after_symbol",
      "mcp__serena__insert_before_symbol",
      "mcp__serena__replace_content",
      "mcp__serena__replace_in_files",
      "mcp__serena__rename_symbol",
      "mcp__serena__safe_delete_symbol",
      "mcp__serena__create_text_file",
      "mcp__serena__execute_shell_command",
      "mcp__serena__write_memory",
      "mcp__serena__edit_memory",
      "mcp__serena__delete_memory",
      "mcp__serena__rename_memory",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:api.github.com)",
      "WebFetch(domain:raw.githubusercontent.com)",
      "WebFetch(domain:codeload.github.com)",
      "WebFetch(domain:gist.github.com)",
      "WebFetch(domain:gist.githubusercontent.com)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/git-guard.mjs"],
            "timeout": 10
          },
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/fg-guard.mjs"],
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "WebFetch",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/git-guard.mjs"],
            "timeout": 10
          }
        ]
      }
    ]
  }
}
