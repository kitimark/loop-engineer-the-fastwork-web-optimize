{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "worktree": {
    "baseRef": "head"
  },
  "permissions": {
    "allow": [
      "Bash(node tools/fix.mjs *)",
      "Bash(node tools/serve.mjs *)",
      "Bash(node tools/verify.mjs *)",
      "Bash(node tools/lock.mjs *)",
      "Bash(node tools/iphone.mjs *)",
      "Bash(node --check *)",
      "Bash(curl -sk https://localhost:*)",
      "Bash(curl -s http://localhost:*)",
      "Bash(git worktree list *)",
      "Bash(git worktree add .claude/worktrees/*)"
    ],
    "ask": [
      "Bash(node tools/mirror.mjs *)",
      "Bash(node tools/prettify.mjs *)"
    ],
    "deny": [
      "Bash(git push *)",
      "Bash(git add -f *)",
      "Bash(git add --force *)",
      "Edit(/site/**)",
      "Edit(/site-pretty/**)"
    ]
  }
}
