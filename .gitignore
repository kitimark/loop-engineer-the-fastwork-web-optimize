# site/ and site-pretty/ are the study's frozen baseline snapshot, pinned by baseline.json. Since the history
# sync with the public repo (user, 2026-10-13) they are untracked: `npm run init` unpacks and verifies the
# release file; the main checkout keeps the original bytes. They stay Fastwork's property: never commit them.
/site/
/site-pretty/
/site/.mirror/missing-local.txt
/site-pretty/.mirror/missing-local.txt
/site/.mirror/chrome-profile/
/site-pretty/.mirror/chrome-profile/
# Per-fix overlays hold full copies of modified Fastwork files: only patch.diff is committed (locally).
fixes/*/overlay/
# measurement output, Chrome profiles, generated certificates
out/
*.pem
node_modules/
.DS_Store
# Claude Code: worktrees created by --worktree / isolation: "worktree" / EnterWorktree, and personal settings
.claude/worktrees/
.claude/settings.local.json
